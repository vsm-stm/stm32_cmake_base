{
	// Комментарии допустимы только целой строкой, начинающейся с //

	// имя проекта и версия (имя = имя целевого файла .elf)
	"name":         "firmware",
	"version":      "3.1",

	// полный код чипа, напр. STM32F446RE, STM32F429ZI, STM32G474RE
	"device":       "STM32f446ret",
	// размер heap и stack для линкер-скрипта (по умолчанию 0x200 / 0x400)
	"heap":         "0x200",
	"stack":        "0x400",

	// драйверы STM32_Drivers_CPP (поддержаны F4 / F7 / G0):
	//   null / false / нет ключа  — не собирать вообще
	//   true или []               — только ядро (system, rcc, gpio, flash, irq)
	//   ["UART", "SPI", ...]      — ядро + перечисленные модули
	"drivers":      null,

	// ваш код и include-пути
	"sources":      ["src/main.cpp"],
	"include_dirs": ["inc"],

	// окно образа во флеше в номерах секторов стирания: [start_sector, end_sector)
	//   start_sector: null — с начала флеша (обычный проект); N — образ над загрузчиком
	//   end_sector:   null — до конца флеша; M — номер сектора, с которого начинается
	//                 СЛЕДУЮЩИЙ образ (сам не входит); не влезший образ — ошибка линковки
	"start_sector": null,
	"end_sector":   null
}
