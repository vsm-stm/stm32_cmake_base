{
  "version": "0.2.1",
  "configurations": [
	{
		"cwd": "${workspaceFolder}",
		"executable": "${command:cmake.launchTargetPath}",
		"name": "ST-Link Launch",
		// "serialNumber": "066CFF575383564867215114",
		"request": "launch",
		"type": "cortex-debug",
		"runToEntryPoint": "main",
		"showDevDebugOutput": "none",
		"servertype": "stlink",
		"liveWatch": {
			"enabled": true,
			"samplesPerSecond": 10
		},
		"preLaunchTask": "CMake: Build",
		"preRestartCommands" : [ "load", "enable breakpoint", "monitor reset" ],
		"svdPath": "${workspaceFolder}/cmsis-core/download_files/SVD.svd"
	},
	{
		"cwd": "${workspaceFolder}",
		"executable": "${command:cmake.launchTargetPath}",
		"name": "ST-Link Attach",
		// "serialNumber": "066CFF575383564867215114",
		"request": "attach",
		"type": "cortex-debug",
		"runToEntryPoint": "main",
		"showDevDebugOutput": "none",
		"servertype": "stlink",
		"liveWatch": {
			"enabled": true,
			"samplesPerSecond": 10
		},
		"preRestartCommands" : [ "load", "enable breakpoint", "monitor reset" ],
		"svdPath": "${workspaceFolder}/cmsis-core/download_files/SVD.svd"
	},
	{
		"cwd": "${workspaceFolder}",
		"executable": "${command:cmake.launchTargetPath}",
		"name": "ST-Link-OCD",
		// "serialNumber": "066CFF575383564867215114",
		"request": "launch",
		"type": "cortex-debug",
		"interface": "swd",
		"runToEntryPoint": "main",
		"showDevDebugOutput": "raw",
		"servertype": "openocd",
		"liveWatch": {
			"enabled": true,
			"samplesPerSecond": 10
		},
		"preLaunchTask": "CMake: Build",
		"preRestartCommands" : [ "load", "enable breakpoint", "monitor reset" ],
		"svdPath": "${workspaceFolder}/cmsis-core/download_files/SVD.svd",
		"configFiles": [
			"interface/stlink.cfg",
			"target/${input:openocdTarget}.cfg"
		],
	},
	{
		"cwd": "${workspaceFolder}",
		"executable": "${command:cmake.launchTargetPath}",
		"name": "ST-Link-OCD-SWO",
		// "serialNumber": "066CFF575383564867215114",
		"request": "launch",
		"type": "cortex-debug",
		"interface": "swd",
		"runToEntryPoint": "main",
		"showDevDebugOutput": "raw",
		"servertype": "openocd",
		"liveWatch": {
			"enabled": true,
			"samplesPerSecond": 10
		},
		"preLaunchTask": "CMake: Build",
		"preRestartCommands" : [ "load", "enable breakpoint", "monitor reset" ],
		"svdPath": "${workspaceFolder}/cmsis-core/download_files/SVD.svd",
		"configFiles": [
			"interface/stlink.cfg",
			"target/${input:openocdTarget}.cfg"
		],
		"swoConfig": {
			"enabled": true,
			"source": "probe",
			"swoFrequency": 2000000,
			// cpuFrequency - the core clock (SYSCLK/HCLK) in Hz, not a chip name.
			// Must match what the firmware actually configures (ClockSystem::Init...):
			// 16000000 is the default HSI right after reset; once PLL is configured,
			// set your real frequency (e.g. 180000000). A mismatch turns the SWO output into garbage.
			// swoFrequency - the SWO line speed, also tuned to the probe/chip pair.
			"cpuFrequency": 16000000,
			"decoders": [
				{
					"port": 0,
					"type": "console",
					"label": "SWO OUT",
					"encoding": "ascii"
				}
			]
		}
	},
	{
		"name": "VS_Launch",
		"type": "cppdbg",
		"request": "launch",
		"cwd": "${workspaceFolder}",
		"program": "${command:cmake.launchTargetPath}",
		"MIMode": "gdb",
		"miDebuggerPath": "${command:vscode-embedded.st.gdb}",
		"miDebuggerServerAddress": "localhost:3333",
		"debugServerPath": "${command:vscode-embedded.st.gdbserver}",
		"debugServerArgs": "--stm32cubeprogrammer-path ${command:vscode-embedded.st.cubeprogrammer} --swd --port-number 3333",
		"serverStarted": "Waiting for connection on port .*\\.\\.\\.",
		"stopAtConnect": true,
		"postRemoteConnectCommands": [
		  {
			"text": "load ${command:cmake.launchTargetPath}"
		  }
		],
		"logging": {
		  "engineLogging": true
		},
		"preLaunchTask": "CMake: Build",
		"svdPath": "${workspaceFolder}/cmsis-core/download_files/SVD.svd"
	  }
  ],
  "inputs": [
    {
      // the chip family for OpenOCD (target/<...>.cfg file); the chip name is not hardcoded in launch.json
      "id": "openocdTarget",
      "type": "pickString",
      "description": "OpenOCD target for your chip",
      "options": ["stm32f0x", "stm32f1x", "stm32f2x", "stm32f3x", "stm32f4x", "stm32f7x", "stm32g0x", "stm32g4x", "stm32h7x", "stm32l0", "stm32l1"],
      "default": "stm32f4x"
    }
  ]
}
