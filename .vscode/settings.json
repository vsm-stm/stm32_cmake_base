{
  "cortex-debug.stm32cubeprogrammer": "C:/ST/STM32CubeCLT_1.19.0/STM32CubeProgrammer/bin",

  "cmake.options.statusBarVisibility": "hidden",
  "cmake.options.advanced": {
    "build": {
      "statusBarVisibility": "inherit"
    },
    "configure": {
      "statusBarVisibility": "visible"
    },
    "launch": {
      "statusBarVisibility": "inherit"
    },
    "debug": {
      "statusBarVisibility": "inherit"
    }
  },

  "VsCodeTaskButtons.tasks": [
    {
      "label": "$(gear) Configure",
      "task": "CMake: Configure",
      "tooltip": "CMake configure с активным пресетом"
    },
    {
      "label": "$(tools) Build",
      "task": "CMake: Build",
      "tooltip": "Собрать проект (активный пресет)"
    },
    {
      "label": "$(debug-restart-frame) Rebuild",
      "task": "CMake: Clean rebuild",
      "tooltip": "Чистая пересборка"
    },
    {
      "label": "$(run) Build+Flash",
      "task": "Build + Flash",
      "tooltip": "Собрать и прошить приложение"
    },
    {
      "label": "$(run-all) Flash all",
      "task": "Build + Flash all (bootloader + app)",
      "tooltip": "С загрузчиком: собрать, прошить bootloader.elf и приложение"
    },
    {
      "label": "$(chip) Flash BL",
      "task": "STM32Prog: Flash bootloader (SWD)",
      "tooltip": "Прошить только bootloader.elf"
    },
    {
      "label": "$(desktop-download) Flash App",
      "task": "STM32Prog: Flash app (SWD)",
      "tooltip": "Прошить приложение (любой *.elf, кроме bootloader.elf) по SWD и запустить"
    },
    {
      "label": "$(refresh) Reset",
      "task": "STM32Prog: Reset target",
      "tooltip": "Аппаратный сброс МК"
    },
    {
      "label": "$(close) Erase",
      "task": "STM32Prog: Full chip erase",
      "tooltip": "Полное стирание чипа по SWD"
    },
    {
      "label": "$(list) Probes",
      "task": "STM32Prog: List interfaces",
      "tooltip": "Список подключённых программаторов"
    }
  ],

  "cortex-debug.variableUseNaturalFormat": false,

  "files.associations": {
    "project.json": "jsonc",
    "cmath": "cpp",
    "deque": "cpp",
    "list": "cpp",
    "sint.h": "c",
    "arm_math.h": "c",
    "array": "cpp",
    "string_view": "cpp",
    "initializer_list": "cpp",
    "string": "cpp",
    "iosfwd": "cpp",
    "limits": "cpp",
    "streambuf": "cpp"
  }
}
