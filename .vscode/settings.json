{
  "cortex-debug.stm32cubeprogrammer": "C:/ST/STM32CubeCLT_1.19.0/STM32CubeProgrammer/bin",

  "cmake.options.statusBarVisibility": "hidden",
  "cmake.options.advanced": {
    "build": {
      "statusBarVisibility": "inherit"
    },
    "configure": {
      "statusBarVisibility": "visible"
    },
    "launch": {
      "statusBarVisibility": "inherit"
    },
    "debug": {
      "statusBarVisibility": "inherit"
    }
  },

  "VsCodeTaskButtons.tasks": [
    {
      "label": "$(gear) Configure",
      "task": "CMake: Configure",
      "tooltip": "CMake configure with the active preset"
    },
    {
      "label": "$(tools) Build",
      "task": "CMake: Build",
      "tooltip": "Build the project (active preset)"
    },
    {
      "label": "$(debug-restart-frame) Rebuild",
      "task": "CMake: Clean rebuild",
      "tooltip": "Clean rebuild"
    },
    {
      "label": "$(run) Build+Flash",
      "task": "Build + Flash",
      "tooltip": "Build and flash the application"
    },
    {
      "label": "$(run-all) Flash all",
      "task": "Build + Flash all (bootloader + app)",
      "tooltip": "With a bootloader: build, flash bootloader.elf and the application"
    },
    {
      "label": "$(chip) Flash BL",
      "task": "STM32Prog: Flash bootloader (SWD)",
      "tooltip": "Flash only bootloader.elf"
    },
    {
      "label": "$(desktop-download) Flash App",
      "task": "STM32Prog: Flash app (SWD)",
      "tooltip": "Flash the active CMake launch target via SWD and start it"
    },
    {
      "label": "$(refresh) Reset",
      "task": "STM32Prog: Reset target",
      "tooltip": "Hardware reset of the MCU"
    },
    {
      "label": "$(close) Erase",
      "task": "STM32Prog: Full chip erase",
      "tooltip": "Full chip erase via SWD"
    },
    {
      "label": "$(list) Probes",
      "task": "STM32Prog: List interfaces",
      "tooltip": "List connected programmers"
    }
  ],

  "cortex-debug.variableUseNaturalFormat": false,

  "files.associations": {
    "project.json": "jsonc",
    "cmath": "cpp",
    "deque": "cpp",
    "list": "cpp",
    "sint.h": "c",
    "arm_math.h": "c",
    "array": "cpp",
    "string_view": "cpp",
    "initializer_list": "cpp",
    "string": "cpp",
    "iosfwd": "cpp",
    "limits": "cpp",
    "streambuf": "cpp"
  }
}
