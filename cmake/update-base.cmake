cmake_minimum_required(VERSION 3.24)

if(NOT IS_ABSOLUTE "${UPDATE_DIR}" OR NOT IS_DIRECTORY "${UPDATE_DIR}")
    message(FATAL_ERROR "UPDATE_DIR must be an existing absolute directory")
endif()
get_filename_component(project_dir "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)

function(file_hash path result)
    set(hash missing)
    if(EXISTS "${path}")
        file(SHA256 "${path}" hash)
    endif()
    set(${result} "${hash}" PARENT_SCOPE)
endfunction()

if(UPDATE_ACTION STREQUAL "apply")
    file(STRINGS "${UPDATE_DIR}/files.txt" files)
    file(MAKE_DIRECTORY "${project_dir}/build")
    file(LOCK "${project_dir}/build/.stm32-base-update.lock" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE lock_error)
    if(NOT lock_error STREQUAL "0")
        message(FATAL_ERROR "Cannot lock the project for an update: ${lock_error}")
    endif()
    foreach(path IN LISTS files)
        file_hash("${project_dir}/${path}" current)
        file_hash("${UPDATE_DIR}/backup/${path}" expected)
        if(NOT current STREQUAL expected)
            message(FATAL_ERROR "Changed since preview: ${path}. Run the update again.")
        endif()
        get_filename_component(parent "${project_dir}/${path}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
    endforeach()

    # project.json is written last. Restore files already touched on copy failure.
    set(touched "")
    foreach(path IN LISTS files)
        list(PREPEND touched "${path}")
        file(COPY_FILE "${UPDATE_DIR}/next/${path}" "${project_dir}/${path}" RESULT copy_error)
        if(NOT copy_error STREQUAL "0")
            foreach(restore IN LISTS touched)
                if(EXISTS "${UPDATE_DIR}/backup/${restore}")
                    file(COPY_FILE "${UPDATE_DIR}/backup/${restore}" "${project_dir}/${restore}" RESULT restore_error)
                    if(NOT restore_error STREQUAL "0")
                        message(WARNING "Could not restore ${restore}: ${restore_error}")
                    endif()
                else()
                    file(REMOVE "${project_dir}/${restore}")
                endif()
            endforeach()
            message(FATAL_ERROR "Could not update ${path}: ${copy_error}")
        endif()
    endforeach()
    message(STATUS "STM32 base updated")
    return()
endif()

if(NOT UPDATE_ACTION STREQUAL "prepare" OR
   NOT TARGET_TAG MATCHES "^v[0-9]+(\\.[0-9]+)?(\\.[0-9]+)?(\\.[0-9]+)?$")
    message(FATAL_ERROR "Specify a target base tag such as v4.1")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/functions.cmake")
set(config_path "${project_dir}/project.json")
_stm32_load_json("${config_path}" config_json)
string(JSON version_type TYPE "${config_json}" version)
string(JSON current_version GET "${config_json}" version)
if(NOT version_type STREQUAL "STRING" OR
   NOT current_version MATCHES "^[0-9]+(\\.[0-9]+)?(\\.[0-9]+)?(\\.[0-9]+)?$")
    message(FATAL_ERROR "project.json: version must match a numeric STM32 base tag")
endif()
set(current_tag "v${current_version}")
if(current_tag STREQUAL TARGET_TAG)
    message(STATUS "STM32 base is already at ${TARGET_TAG}")
    return()
endif()
string(SUBSTRING "${TARGET_TAG}" 1 -1 target_version)

find_package(Git REQUIRED)
set(base_repository "https://github.com/vsm-stm/stm32_cmake_base.git")
execute_process(COMMAND "${GIT_EXECUTABLE}" init --quiet "${UPDATE_DIR}/repository"
    COMMAND_ERROR_IS_FATAL ANY)
foreach(tag IN ITEMS "${current_tag}" "${TARGET_TAG}")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${UPDATE_DIR}/repository"
        fetch --quiet --no-tags --depth 1 "${base_repository}" "refs/tags/${tag}"
        RESULT_VARIABLE git_error)
    if(NOT git_error STREQUAL "0")
        message(FATAL_ERROR "Could not download STM32 base ${tag}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${UPDATE_DIR}/repository"
        archive --format=tar "--output=${UPDATE_DIR}/${tag}.tar" FETCH_HEAD
        COMMAND_ERROR_IS_FATAL ANY)
    file(ARCHIVE_EXTRACT INPUT "${UPDATE_DIR}/${tag}.tar" DESTINATION "${UPDATE_DIR}/${tag}")
endforeach()

set(previous "${UPDATE_DIR}/${current_tag}")
set(target "${UPDATE_DIR}/${TARGET_TAG}")
file(GLOB_RECURSE files RELATIVE "${target}"
    "${target}/cmake/*" "${target}/no_system_files/*"
    "${target}/cmsis-core/Include/*" "${target}/.vscode/*")
list(APPEND files CMakeLists.txt CMakePresets.json)
list(SORT files)

# Ignore checkout line endings when comparing the platform's text files.
function(read_text path result)
    file(READ "${path}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    set(${result} "${content}" PARENT_SCOPE)
endfunction()

message(STATUS "STM32 base ${current_tag} -> ${TARGET_TAG}")
set(plan "")
foreach(path IN LISTS files)
    read_text("${target}/${path}" incoming)
    if(EXISTS "${project_dir}/${path}")
        read_text("${project_dir}/${path}" current)
        if(current STREQUAL incoming)
            continue()
        endif()

        set(change "Replace (local edit)")
        if(EXISTS "${previous}/${path}")
            read_text("${previous}/${path}" installed)
            if(current STREQUAL installed)
                set(change "Replace")
            endif()
        endif()

        get_filename_component(parent "${UPDATE_DIR}/backup/${path}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        file(COPY_FILE "${project_dir}/${path}" "${UPDATE_DIR}/backup/${path}")
    else()
        set(change "Add")
    endif()
    get_filename_component(parent "${UPDATE_DIR}/next/${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(COPY_FILE "${target}/${path}" "${UPDATE_DIR}/next/${path}")
    string(APPEND plan "${path}\n")
    message(STATUS "  ${change}: ${path}")
endforeach()

# Keep the original formatting and comments. Verify that only the top-level
# version changed, even when the text also contains a nested 'version' key.
file(MAKE_DIRECTORY "${UPDATE_DIR}/backup" "${UPDATE_DIR}/next")
file(COPY_FILE "${config_path}" "${UPDATE_DIR}/backup/project.json")
# Read bytes so CMake does not normalize the project's line endings.
file(READ "${UPDATE_DIR}/backup/project.json" config_hex HEX)
string(REGEX MATCHALL ".." config_bytes "${config_hex}")
set(config_codes "")
foreach(byte IN LISTS config_bytes)
    math(EXPR code "0x${byte}")
    list(APPEND config_codes "${code}")
endforeach()
string(ASCII ${config_codes} config_text)
string(JSON expected_json SET "${config_json}" version "\"${target_version}\"")
set(prefix "")
set(remaining "${config_text}")
set(version_updated FALSE)
while(remaining MATCHES "(\"version\"[ \t\r\n]*:[ \t\r\n]*\")[0-9.]+\"")
    set(match "${CMAKE_MATCH_0}")
    set(replacement "${CMAKE_MATCH_1}${target_version}\"")
    string(FIND "${remaining}" "${match}" offset)
    string(SUBSTRING "${remaining}" 0 "${offset}" before)
    string(LENGTH "${match}" match_length)
    math(EXPR offset "${offset} + ${match_length}")
    string(SUBSTRING "${remaining}" "${offset}" -1 remaining)
    string(APPEND prefix "${before}")
    set(updated_config "${prefix}${replacement}${remaining}")
    string(REGEX REPLACE "(^|\n)[ \t]*//[^\n]*" "\\1" updated_json "${updated_config}")
    string(JSON version_updated EQUAL "${updated_json}" "${expected_json}")
    if(version_updated)
        break()
    endif()
    string(APPEND prefix "${match}")
endwhile()
if(NOT version_updated)
    message(FATAL_ERROR "Could not edit the top-level version in project.json")
endif()
# file(CONFIGURE) adds a final newline and writes without host conversion.
string(REGEX REPLACE "\n$" "" updated_config "${updated_config}")
file(CONFIGURE OUTPUT "${UPDATE_DIR}/next/project.json" CONTENT "@updated_config@" @ONLY NEWLINE_STYLE UNIX)
file(WRITE "${UPDATE_DIR}/files.txt" "${plan}project.json\n")
message(STATUS "  Set project.json version: ${current_version} -> ${target_version}")
